            "value" : "尚未检查。"
          }
        }
      }
    },
    "Not enough free space on %@: about %@ MB are needed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not enough free space on %1$@: about %2$@ MB are needed."
          }
        },
        "zh-Hans" : {
