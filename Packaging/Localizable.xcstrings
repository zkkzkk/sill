    "60 fps" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 fps"
          }
        }
      }
    },
    "A code is showing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在显示配对码。"
          }
        }
      }
    },
    "A device" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一台设备"
          }
        }
      }
    },
    "A paired device can see and control this Mac on your network, nearby, and from afar while Remote Access is on. If one is lost, remove it here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已配对的设备可以在你的网络中、在附近，以及在远程访问打开时从远处查看并控制这台 Mac。如果设备丢失，请在这里移除它。"
          }
        }
      }
    },
    "A paired device can see and control this Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已配对的设备可以查看并控制这台 Mac。"
          }
        }
      }
    },
    "A stop signed with Sill’s update key names Sill %@, so Sill won’t install it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一份用 Sill 更新密钥签名的停止声明指明了 Sill %@，因此 Sill 不会安装它。"
          }
        }
      }
    },
    "A wrong code came from %@. %lld tries left." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 输入了错误的配对码。还剩 %2$lld 次机会。"
          }
        }
      }
    },
    "A wrong code came from %@. 1 try left." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 输入了错误的配对码。还剩 1 次机会。"
          }
        }
      }
    },
    "About Sill" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于 Sill"
          }
        }
      }
    },
    "Access belongs to Sill itself. Access you gave Terminal for the SillHost command-line tool doesn’t carry over." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "权限属于 Sill 本身。你为 SillHost 命令行工具授予“终端”的权限不会沿用到这里。"
          }
        }
      }
    },
    "Accessibility" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辅助功能"
          }
        }
      }
    },
    "Accessibility: Allowed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
