    },
    "High" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高"
          }
        }
      }
    },
    "IPv6" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPv6"
          }
        }
      }
    },
    "If your iPhone or iPad can’t find this Mac, allow Sill in Privacy & Security › Local Network." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 iPhone 或 iPad 找不到这台 Mac，请在“隐私与安全性 › 本地网络”中允许 Sill。"
          }
        }
      }
    },
    "If your router has a dynamic DNS name, enter it so your devices keep finding this Mac when your internet address changes. Add :port if the router forwards a different outside port." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你的路由器有动态 DNS 域名，请在此输入，这样互联网地址变化后设备仍能找到这台 Mac。如果路由器转发的外部端口不同，请加上“:端口”。"
          }
        }
      }
    },
    "In Sill on your iPhone or iPad, tap this Mac, or tap Add a Mac… when you’re away, then point it at this code." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 或 iPad 上的 Sill 中轻点这台 Mac（不在家时轻点“添加 Mac…”），然后对准这个配对码。"
          }
        }
      }
    },
    "Install Now" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即安装"
          }
        }
      }
    },
    "Install and Disconnect" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装并断开连接"
          }
        }
      }
    },
    "Installing" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在安装"
          }
        }
      }
    },
    "Installing %@…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在安装 %@…"
          }
        }
      }
    },
    "Installing it restarts Sill and disconnects %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装会重新启动 Sill，并断开 %@ 的连接。"
          }
        }
      }
    },
    "Installs by itself while no device is connected" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有设备连接时将自行安装"
          }
        }
      }
    },
    "Internet" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互联网"
          }
        }
      }
    },
    "It paired by itself over the USB cable, and can connect over Wi‑Fi and nearby from now on too." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已通过 USB 线自动配对，今后也可以通过 Wi‑Fi 和在附近连接。"
          }
        }
      }
    },
    "It tried to connect with an older Sill." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它尝试用旧版 Sill 连接。"
          }
        }
      }
    },
    "Its windows come back once it is unlocked." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁后它的窗口就会回来。"
          }
        }
      }
    },
    "Last checked %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次检查：%@。"
          }
        }
      }
    },
    "Last window" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一个窗口"
          }
        }
      }
    },
    "Launch at Login" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录时启动"
          }
        }
      }
    },
    "Launch at login" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录时启动"
          }
        }
      }
    },
    "Lets Sill capture the windows you pick on your iPhone or iPad, and their sound when Send Audio is on. Nothing is recorded or saved; frames and sound go straight to your devices." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Sill 捕获你在 iPhone 或 iPad 上选择的窗口，并在打开“传送声音”时捕获其声音。不会录制或保存任何内容；画面和声音直接发送到你的设备。"
          }
        }
      }
    },
    "Lets the iPhone and iPad you pair connect to this Mac from other networks: through a VPN such as Tailscale, or through a port you forward on your router. Sill turns away every device you haven’t paired, and encrypts everything the paired ones send and receive." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让你配对的 iPhone 和 iPad 从其他网络连接到这台 Mac：通过 Tailscale 等 VPN，或通过你在路由器上转发的端口。Sill 会拒绝所有未配对的设备，并加密已配对设备收发的所有内容。"
          }
        }
      }
    },
    "Lets your iPhone and iPad connect when they’re near this Mac, even without a shared Wi‑Fi network, the way AirDrop does. While it’s on, this Mac’s Wi‑Fi keeps stepping away from your network, so streaming over Wi‑Fi can stutter. Anyone nearby with Sill can find this Mac; only devices you paired can connect, unless Require pairing is off." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像隔空投送一样，即使没有共同的 Wi‑Fi 网络，iPhone 和 iPad 在这台 Mac 附近时也能连接。打开期间，这台 Mac 的 Wi‑Fi 会不断短暂离开你的网络，因此通过 Wi‑Fi 串流可能会卡顿。附近任何装有 Sill 的人都能发现这台 Mac；除非关闭了“需要配对”，否则只有你配对过的设备才能连接。"
          }
        }
      }
    },
    "Lets your iPhone or iPad click, scroll and type on this Mac, and lets Sill move and size the window it streams." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 iPhone 或 iPad 可以在这台 Mac 上点按、滚动和输入，并让 Sill 移动和调整所串流窗口的大小。"
          }
        }
      }
    },
    "Local Network" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地网络"
          }
        }
      }
    },
    "Log in to your account to reactivate screen sharing with Sill." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请登录你的账户以重新启用 Sill 屏幕共享。"
          }
        }
      }
    },
    "Low" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低"
          }
        }
      }
    },
    "Lower latency when the Mac is busy, at a softer picture." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 繁忙时延迟更低，但画面会稍软。"
          }
        }
      }
    },
    "Minimize" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最小化"
          }
        }
      }
    },
    "Name" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称"
          }
        }
      }
    },
    "Needed to show your windows on your devices." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设备上显示你的窗口需要此权限。"
          }
        }
      }
    },
    "Needs Accessibility" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要辅助功能权限"
          }
        }
      }
    },
    "Needs Screen Recording" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要屏幕录制权限"
          }
        }
      }
    },
    "Needs Screen Recording and Accessibility" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要屏幕录制和辅助功能权限"
          }
        }
      }
    },
    "Needs attention" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要处理"
          }
        }
      }
    },
    "New Code" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新配对码"
          }
        }
      }
    },
    "Nightly builds are built and signed by GitHub from Sill’s newest code; nobody looks at them first. They are less tested than releases and may break. Sill tells you when one is out, and Update Now installs it; a nightly never installs by itself, even with Automatically update Sill on. Turning this off doesn’t go back to the last release: Sill keeps the nightly you have until a release that is at least as new." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每夜版由 GitHub 根据 Sill 的最新代码构建并签名，事先没有经过任何人检查。它们的测试不如正式版充分，可能会出问题。有新的每夜版时 Sill 会告诉你，点按“立即更新”即可安装；即使开启了“自动更新 Sill”，每夜版也从不自行安装。关闭此项不会退回到上一个正式版：Sill 会保留你当前的每夜版，直到出现至少同样新的正式版。"
          }
        }
      }
    },
    "No VPN is running on this Mac. Install one such as Tailscale on this Mac and on your iPhone or iPad, or allow connections from the internet below." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上没有运行 VPN。请在这台 Mac 和你的 iPhone 或 iPad 上安装 Tailscale 之类的 VPN，或在下方允许来自互联网的连接。"
          }
        }
      }
    },
    "No paired devices yet." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有已配对的设备。"
          }
        }
      }
    },
    "No shared network needed; Wi‑Fi streams can stutter" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需共同网络；Wi‑Fi 串流可能会卡顿"
          }
        }
      }
    },
    "None" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无"
          }
        }
      }
    },
    "Not Visible on the Network" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在网络上不可见"
          }
        }
      }
    },
    "Not advertised (test pattern mode)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未广播（测试图案模式）"
          }
        }
      }
    },
    "Not advertised; test clients connect to port %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未广播；测试客户端连接到端口 %@。"
          }
        }
      }
    },
    "Not available on this version of macOS: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本 macOS 不可用：%@"
          }
