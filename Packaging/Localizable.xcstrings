    },
    "Sill %@ is available." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sill %@ 已推出。"
          }
        }
      }
    },
    "Sill %@ isn’t signed with Sill’s update key yet, so it can’t be installed from here. Try again later, or open its release page." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
