        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sill 日志"
          }
        }
      }
    },
    "Sill appears on your iPhone and iPad once this Mac is on Wi-Fi or Ethernet and Local Network access is allowed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 连上 Wi-Fi 或以太网并允许本地网络访问后，Sill 就会出现在你的 iPhone 和 iPad 上。"
          }
        }
      }
    },
    "Sill at %@ changed since it started. Quit Sill and open it again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Sill 在启动后已被更改。请退出 Sill 后重新打开。"
          }
        }
      }
    },
    "Sill belongs to another account on this Mac (%@). Update it from that account." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sill 属于这台 Mac 上的另一个账户（%@）。请从那个账户更新。"
          }
        }
      }
    },
    "Sill changed on disk since it started. Quit Sill and open it again, then update." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘上的 Sill 在启动后已被更改。请退出 Sill 后重新打开，然后再更新。"
          }
        }
      }
    },
    "Sill couldn’t put %@ back in place. Download Sill again from getsill.app and put it in your Applications folder." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sill 无法将 %@ 放回原位。请从 getsill.app 重新下载 Sill，并将它放到“应用程序”文件夹中。"
          }
        }
      }
    },
    "Sill couldn’t put %@ back in place. It is at %@: quit Sill and move it to your Applications folder soon, as macOS empties that folder after a few days." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sill couldn’t put %1$@ back in place. It is at %2$@: quit Sill and move it to your Applications folder soon, as macOS empties that folder after a few days."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sill 无法将 %1$@ 放回原位。它位于 %2$@：请尽快退出 Sill 并将它移到“应用程序”文件夹中，因为 macOS 会在几天后清空那个文件夹。"
          }
        }
      }
    },
    "Sill couldn’t read what it keeps for this setting, so it is off. Turning it on starts it afresh." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sill 无法读取为此设置保存的数据，因此它已关闭。打开它会重新开始。"
          }
        }
      }
    },
    "Sill couldn’t use its key in your keychain." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sill 无法使用钥匙串中的密钥。"
          }
        }
      }
    },
    "Sill couldn’t use its key in your keychain. Quit Sill and open it again, and choose Always Allow if the keychain asks." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sill 无法使用钥匙串中的密钥。请退出 Sill 后重新打开；如果钥匙串询问，请选择“始终允许”。"
          }
        }
      }
    },
    "Sill couldn’t write the update" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sill 无法写入更新"
          }
        }
      }
    },
    "Sill didn’t install %@ by itself: %@. Update Now still can." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sill didn’t install %1$@ by itself: %2$@. Update Now still can."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sill 没有自行安装 %1$@：%2$@。仍可使用“立即更新”安装。"
          }
        }
      }
    },
    "Sill doesn’t check for updates in test pattern mode." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试图案模式下 Sill 不检查更新。"
          }
        }
      }
    },
    "Sill installs it by itself %@ or later, once no device has been connected for %lld minutes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sill installs it by itself %1$@ or later, once no device has been connected for %2$lld minutes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 或之后，且连续 %2$lld 分钟没有设备连接时，Sill 会自行安装它。"
          }
        }
      }
    },
    "Sill installs it by itself %@, once no device has been connected for %lld minutes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sill installs it by itself %1$@, once no device has been connected for %2$lld minutes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，且连续 %2$lld 分钟没有设备连接时，Sill 会自行安装它。"
          }
        }
      }
    },
    "Sill installs it by itself once no device has been connected for %lld minutes, then restarts." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
