        }
      }
    },
    "%lld fps, still" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld fps，画面静止"
          }
        }
      }
    },
    "%lld fps, the link can’t carry %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld fps，当前链路带不动“%2$@”"
          }
        }
      }
    },
    "%lld hours after it first finds it" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次发现 %lld 小时后"
