        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连续 %lld 分钟没有设备连接时，Sill 会自行安装它。"
          }
        }
      }
    },
    "Sill is in a folder this account can’t change (%@)." : {
      "localizations" : {
        "zh-Hans" : {
