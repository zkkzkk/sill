            "state" : "translated",
            "value" : "关"
          }
        }
      }
    },
    "Off for this session: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次运行已关闭：%@"
          }
        }
      }
    },
    "On a Retina display, a quarter of the pixels to encode" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Retina 显示器上，只需编码四分之一的像素"
