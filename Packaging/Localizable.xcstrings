{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@ asked to pair." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@的 %1$@ 请求配对。"
          }
        }
      }
    },
    "%@ Connected" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已连接"
          }
        }
      }
    },
    "%@ Is Available…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已推出…"
          }
        }
      }
    },
    "%@ Is Ready to Install…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已可安装…"
          }
        }
      }
    },
    "%@ Mbps" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Mbps"
          }
        }
      }
    },
    "%@ Wants to Pair" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请求配对"
          }
        }
      }
    },
    "%@ and %@" : {
      "comment" : "The last two items of a list",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@和%2$@"
          }
        }
      }
    },
    "%@ and %@ need the USB cable or very fast Wi‑Fi; if the picture lags, step down." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@和%2$@需要 USB 线或非常快的 Wi‑Fi；如果画面卡顿，请调低一档。"
          }
        }
      }
    },
    "%@ and its executable" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 及其可执行文件"
          }
        }
      }
    },
    "%@ asked to pair." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请求配对。"
          }
        }
      }
    },
    "%@ can no longer connect." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已无法再连接。"
          }
        }
      }
    },
    "%@ can no longer connect. To use it again, pair it again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已无法再连接。要再次使用，请重新配对。"
          }
        }
      }
    },
    "%@ couldn’t be read" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取%@"
          }
        }
      }
    },
    "%@ couldn’t be saved" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存%@"
          }
        }
      }
    },
    "%@ didn’t start, so %@ is back." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ didn’t start, so %2$@ is back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未能启动，已恢复为 %2$@。"
          }
        }
      }
    },
    "%@ is available." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已推出。"
          }
        }
      }
    },
    "%@ is locked" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已锁定"
          }
        }
      }
    },
    "%@ is locked. Unlock it to see its windows." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已锁定。解锁后才能看到它的窗口。"
          }
        }
      }
    },
    "%@ is paired with this Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已与这台 Mac 配对。"
          }
        }
      }
    },
    "%@ is ready." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已准备就绪。"
          }
        }
      }
    },
    "%@ is still paired: Sill couldn’t update the keychain (%@). Try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 仍处于配对状态：Sill 无法更新钥匙串（%2$@）。请再试一次。"
          }
        }
      }
    },
    "%@ is unchanged." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 保持不变。"
          }
        }
      }
    },
    "%@ isn’t signed with Sill’s nightly key yet, so it can’t be installed from here. Try again later." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 尚未用 Sill 的每夜版密钥签名，因此无法在这里安装。请稍后再试。"
          }
        }
      }
    },
    "%@ of %@ MB" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@ MB"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@ MB"
          }
        }
      }
    },
    "%@ times" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 倍"
          }
        }
      }
    },
    "%@ was installed successfully." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已成功安装。"
          }
        }
      }
    },
    "%@ — %lld Mbps" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — %2$lld Mbps"
          }
        }
      }
    },
    "%@ — Not connected" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 未连接"
          }
        }
      }
    },
    "%@, %@ and %lld more" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@ and %3$lld more"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@ 及另外 %3$lld 台设备"
          }
        }
      }
    },
    "%@. Quit and reopen Sill to try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。退出并重新打开 Sill 后再试。"
          }
        }
      }
    },
    "%@×%@ · %@ · %lld Mbps" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@×%2$@ · %3$@ · %4$lld Mbps"
          }
        }
      }
    },
    "%lld" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        }
      }
    },
    "%lld Devices" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 台设备"
          }
        }
      }
    },
    "%lld fps · frame age %@ · RTT %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld fps · 帧延迟 %2$@ · RTT %3$@"
