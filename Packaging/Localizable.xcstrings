            "value" : "帧率上限"
          }
        }
      }
    },
    "General" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通用"
          }
        }
      }
    },
    "Getting %@ from GitHub…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在从 GitHub 获取 %@…"
          }
